# ---- Free-tier AI stack (add to .env.example, placeholders only) ----
# Provider selection: auto | groq | demo
LLM_PROVIDER=auto
# Provider selection: auto | deepgram | browser | demo
STT_PROVIDER=auto

# LLM (Groq, OpenAI-compatible). Key from console.groq.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Check Groq's current model list and override if these are retired
GROQ_MODEL_LIVE=llama-3.1-8b-instant
GROQ_MODEL_REPORT=llama-3.3-70b-versatile

# STT (Deepgram). Key from console.deepgram.com
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Browser API calls use the same-origin /api proxy; leave blank for LAN access
NEXT_PUBLIC_API_URL=
API_INTERNAL_URL=http://127.0.0.1:8000
