{
  "name": "voicehire",
  "version": "0.1.0",
  "description": "Real-time AI Interview Performance Engine",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "dev:web": "pnpm --filter @voicehire/web dev",
    "dev:api": "pnpm --filter @voicehire/api dev",
    "build": "pnpm -r --if-present build",
    "type-check": "pnpm -r --if-present type-check",
    "test": "pnpm -r --if-present test",
    "test:api": "pnpm --filter @voicehire/api test",
    "lint": "pnpm -r --if-present lint",
    "format": "pnpm -r --if-present format",
    "clean": "pnpm -r --if-present clean"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "source-map-js": "^1.2.2"
  }
}
