# Local Compose/API configuration. Copy to .env; never commit populated secrets.
APP_ENV=development
DEMO_MODE=true

# Local development defaults to SQLite; set DATABASE_URL to PostgreSQL when deployed.
DATABASE_URL=sqlite+aiosqlite:///./voicehire_local.db
POSTGRES_PASSWORD=voicehire_dev_only
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1,api

# Optional backend providers. Leave blank to run labeled demo/text-only mode.
# Server-only: API reads these; never put them in a web-exposed environment.
LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_STRONG_MODEL=llama-3.3-70b-versatile
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
EVALUATION_RUBRIC_WEIGHTS=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_EXPIRATION=3600
CLERK_SECRET_KEY=
CLERK_JWT_JWKS_URL=

# Better Auth (alternative to Clerk — set BETTER_AUTH_SECRET to activate; leave blank when using Clerk)
# Generate secret: openssl rand -hex 32   (must be >=32 chars)
# BETTER_AUTH_URL: public base URL of the Next.js web app (e.g. https://voicehire.vercel.app)
# BETTER_AUTH_JWKS_URL: leave blank — auto-derived as <BETTER_AUTH_URL>/api/auth/jwks
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_JWKS_URL=

# Public web build settings (not secrets). Keep the API URL blank to use the
# same-origin Next.js proxy; only set it when intentionally calling an API origin directly.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
NEXT_PUBLIC_DEMO_MODE=true
